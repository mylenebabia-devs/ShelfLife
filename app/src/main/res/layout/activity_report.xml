<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/cream">
  <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" app:navigationIcon="?attr/homeAsUpIndicator" app:title="Reports" app:logo="@drawable/shelflife_toolbar" app:logoDescription="ShelfLife logo" />
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
      <TextView android:id="@+id/reportHeadline" style="@style/Text.Shelf.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Know your stock." />
      <TextView style="@style/Text.Shelf.Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A clear view of what is here and what has moved." android:layout_marginTop="8dp" />
      <TextView android:id="@+id/tvGenerated" style="@style/Text.Shelf.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:layout_marginTop="8dp" />
      <com.google.android.material.card.MaterialCardView style="@style/Widget.Shelf.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/soft_green" android:layout_marginTop="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
          <TextView style="@style/Text.Shelf.Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="INVENTORY SNAPSHOT" />
          <TextView android:id="@+id/tvTotal" style="@style/Text.Shelf.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:layout_marginTop="12dp" />
          <TextView android:id="@+id/tvExpired" style="@style/Text.Shelf.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:layout_marginTop="12dp" android:textColor="@color/status_expired" />
          <TextView android:id="@+id/tv1" style="@style/Text.Shelf.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:layout_marginTop="8dp" />
          <TextView android:id="@+id/tv3" style="@style/Text.Shelf.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:layout_marginTop="8dp" />
          <TextView android:id="@+id/tv7" style="@style/Text.Shelf.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:layout_marginTop="8dp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnExport" style="@style/Widget.Shelf.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Download CSV report" app:icon="@drawable/ic_download" android:layout_marginTop="16dp" />
      <TextView style="@style/Text.Shelf.Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DATE WATCH" android:layout_marginTop="20dp" />
      <TextView style="@style/Text.Shelf.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Needs your attention" android:layout_marginTop="4dp" />
      <com.google.android.material.card.MaterialCardView style="@style/Widget.Shelf.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/surface_white" android:layout_marginTop="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
          <TextView android:id="@+id/tvAttention" style="@style/Text.Shelf.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <TextView style="@style/Text.Shelf.Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="STOCK MOVEMENTS" android:layout_marginTop="20dp" />
      <TextView style="@style/Text.Shelf.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A record of every change" android:layout_marginTop="4dp" />
      <com.google.android.material.card.MaterialCardView style="@style/Widget.Shelf.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/surface_white" android:layout_marginTop="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
          <TextView android:id="@+id/tvHistory" style="@style/Text.Shelf.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnReverse" style="@style/Widget.Shelf.Button.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Correct a movement" app:icon="@drawable/ic_edit" android:layout_marginTop="12dp" />
      <LinearLayout android:id="@+id/movementList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" />
    </LinearLayout>
  </ScrollView>
</LinearLayout>