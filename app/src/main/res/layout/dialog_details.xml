<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true" android:background="@color/cream">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <ImageView android:id="@+id/detailPhoto" android:layout_width="match_parent" android:layout_height="160dp" android:scaleType="centerInside" android:contentDescription="Product photo" android:visibility="gone" />
    <TextView android:id="@+id/detailCategory" style="@style/Text.Shelf.Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" />
    <TextView android:id="@+id/detailName" style="@style/Text.Shelf.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:layout_marginTop="8dp" android:textSize="23sp" />
    <TextView android:id="@+id/detailCode" style="@style/Text.Shelf.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:layout_marginTop="6dp" />
    <com.google.android.material.card.MaterialCardView style="@style/Widget.Shelf.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/soft_green" android:layout_marginTop="20dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/Text.Shelf.Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Available stock" />
        <TextView android:id="@+id/detailQuantity" style="@style/Text.Shelf.Number" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:layout_marginTop="10dp" />
        <TextView android:id="@+id/detailStatus" style="@style/Text.Shelf.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:layout_marginTop="8dp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView android:id="@+id/detailInfo" style="@style/Text.Shelf.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:layout_marginTop="20dp" android:lineSpacingExtra="8dp" />
    <TextView android:id="@+id/detailFefo" style="@style/Text.Shelf.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:layout_marginTop="16dp" android:background="@drawable/bg_warning" android:padding="14dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnDetailOut" style="@style/Widget.Shelf.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Record stock out" app:icon="@drawable/ic_arrow" android:layout_marginTop="6dp" android:minHeight="48dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnDetailAdd" style="@style/Widget.Shelf.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Add stock" app:icon="@drawable/ic_add" android:layout_marginTop="6dp" android:minHeight="48dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnDetailEdit" style="@style/Widget.Shelf.Button.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Edit product" app:icon="@drawable/ic_edit" android:layout_marginTop="6dp" android:minHeight="48dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnDetailAll" style="@style/Widget.Shelf.Button.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="View all stock entries" app:icon="@drawable/ic_box" android:layout_marginTop="6dp" android:minHeight="48dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnDetailArchive" style="@style/Widget.Shelf.Button.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Archive product" android:layout_marginTop="6dp" android:minHeight="48dp" />
    <TextView style="@style/Text.Shelf.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recorded dates do not certify physical freshness or safety." android:layout_marginTop="14dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnDetailDelete" style="@style/Widget.Shelf.Button.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Delete product" android:textColor="@color/status_expired" android:minHeight="48dp" android:layout_marginTop="6dp" />
    <com.google.android.material.button.MaterialButton style="@style/Widget.Shelf.Button.Outline" android:id="@+id/btnPermanentDelete" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Delete permanently" android:textColor="@color/status_expired" android:visibility="gone" android:minHeight="48dp" />
  </LinearLayout>
</ScrollView>