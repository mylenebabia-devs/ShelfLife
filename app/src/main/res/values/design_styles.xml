<resources>
  <style name="Text.Shelf" parent="android:style/TextAppearance.Material.Body1">
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:textColor">@color/ink</item>
    <item name="android:includeFontPadding">false</item>
  </style>
  <style name="Text.Shelf.Body">
    <item name="android:textSize">14sp</item>
    <item name="android:lineSpacingExtra">4dp</item>
  </style>
  <style name="Text.Shelf.Muted" parent="Text.Shelf.Body">
    <item name="android:textColor">@color/muted</item>
  </style>
  <style name="Text.Shelf.Small" parent="Text.Shelf.Muted">
    <item name="android:textSize">12sp</item>
  </style>
  <style name="Text.Shelf.Eyebrow" parent="Text.Shelf.Small">
    <item name="android:textColor">@color/brand_primary</item>
    <item name="android:letterSpacing">0.12</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="Text.Shelf.Title">
    <item name="android:textSize">28sp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:letterSpacing">-0.025</item>
  </style>
  <style name="Text.Shelf.Section">
    <item name="android:textSize">19sp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
  </style>
  <style name="Text.Shelf.Number">
    <item name="android:textSize">30sp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:letterSpacing">-0.03</item>
  </style>
  <style name="Widget.Shelf.Card" parent="Widget.Material3.CardView.Outlined">
    <item name="cardCornerRadius">22dp</item>
    <item name="cardElevation">0dp</item>
    <item name="strokeWidth">1dp</item>
    <item name="strokeColor">@color/line</item>
    <item name="cardBackgroundColor">@color/surface_white</item>
  </style>
  <style name="Widget.Shelf.Button" parent="Widget.Material3.Button"><item name="backgroundTint">@color/button_primary</item><item name="rippleColor">#26FFFFFF</item>
    <item name="android:minHeight">52dp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">14sp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="cornerRadius">16dp</item>
    <item name="android:insetTop">3dp</item>
    <item name="android:insetBottom">3dp</item>
    <item name="iconGravity">textStart</item>
    <item name="iconSize">20dp</item>
  </style>
  <style name="Widget.Shelf.Button.Secondary" parent="Widget.Shelf.Button">
    <item name="backgroundTint">@color/button_secondary</item>
    <item name="android:textColor">@color/brand_primary</item>
    <item name="iconTint">@color/brand_primary</item>
  </style>
  <style name="Widget.Shelf.Button.Outline" parent="Widget.Material3.Button.OutlinedButton"><item name="backgroundTint">@color/button_outline</item><item name="rippleColor">#18166534</item>
    <item name="android:minHeight">52dp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">14sp</item>
    <item name="cornerRadius">16dp</item>
    <item name="strokeColor">@color/line</item>
    <item name="iconGravity">textStart</item>
  </style>
  <style name="Widget.Shelf.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
    <item name="boxCornerRadiusTopStart">14dp</item>
    <item name="boxCornerRadiusTopEnd">14dp</item>
    <item name="boxCornerRadiusBottomStart">14dp</item>
    <item name="boxCornerRadiusBottomEnd">14dp</item>
    <item name="boxBackgroundColor">@color/surface_white</item>
    <item name="boxStrokeColor">@color/input_stroke</item>
    <item name="hintTextColor">@color/brand_primary</item>
  </style>
  <style name="Shape.Shelf.Dialog" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">24dp</item>
  </style>
  <style name="Overlay.Shelf.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
    <item name="shapeAppearanceMediumComponent">@style/Shape.Shelf.Dialog</item>
    <item name="colorSurface">@color/cream</item><item name="colorSurfaceContainerHigh">@color/cream</item>
  </style>
  <style name="Shape.Shelf.Avatar" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">50%</item>
  </style>
<style name="Text.Shelf.Navigation" parent="TextAppearance.Material3.LabelMedium"><item name="android:textSize">12sp</item><item name="android:fontFamily">sans-serif-medium</item></style></resources>